# DocuProcess AI Environment Variables Template
# Copy this file to .env: cp .env.example .env

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=docuprocess
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docuprocess

# Security / JWT
SECRET_KEY=supersecretkeywhichshouldbechangedinproduction
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / OCR / RAG Configuration
RAG_SIMILARITY_THRESHOLD=0.1
